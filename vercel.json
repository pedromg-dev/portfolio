{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^es.*" }],
      "destination": "/es",
      "permanent": false
    },
    { "source": "/", "destination": "/en", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
